Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

%labels
    Author OCEAN MRF Project
    Version 1.0
    Description Headless HPC image for OCEAN CEST-MRF processing

%environment
    export PATH=/opt/conda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export MPLBACKEND=Agg

%post
    export DEBIAN_FRONTEND=noninteractive
    export PATH=/opt/conda/bin:$PATH

    apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ gfortran libstdc++6 \
        swig \
        git \
        wget \
        libhdf5-dev \
        libopenblas-dev \
        ffmpeg libsm6 libxext6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

    wget -qO /tmp/miniconda.sh \
        "https://repo.anaconda.com/miniconda/Miniconda3-py39_23.11.0-1-Linux-x86_64.sh"
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh

    /opt/conda/bin/conda install -y -c conda-forge \
        python=3.9 \
        numpy=1.23.5 \
        scipy=1.10.0 \
        matplotlib=3.9.0 \
        h5py=3.10.0 \
        hdf5 \
    && /opt/conda/bin/conda clean -afy

    /opt/conda/bin/pip install --no-cache-dir \
        pymatreader \
        nibabel \
        pydicom \
        PyYAML==6.0 \
        tqdm \
        numba==0.60.0 \
        llvmlite==0.43.0 \
        BMCTool==0.5.0 \
        sigpy==0.1.22 \
        ipykernel==6.29.0

    /opt/conda/bin/pip install --no-cache-dir \
        torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 \
        --index-url https://download.pytorch.org/whl/cu118

    cd /tmp/src/open-py-cest-mrf/cest_mrf/sim_lib \
        && /opt/conda/bin/python setup.py build_ext --inplace \
        && /opt/conda/bin/python setup.py install

    /opt/conda/bin/pip install --no-cache-dir -e /tmp/src/open-py-cest-mrf

    mkdir -p /opt/ocean
    cp /tmp/src/MRFmatch_mt.py        /opt/ocean/
    cp /tmp/src/MRFmatch_B-SL_dk.py   /opt/ocean/
    cp /tmp/src/colormaps_dk.py        /opt/ocean/
    cp -r /tmp/src/utils/              /opt/ocean/utils/

    mkdir -p /data/input /data/output

%files
    open-py-cest-mrf        /tmp/src/open-py-cest-mrf
    MRFmatch_mt.py          /tmp/src/MRFmatch_mt.py
    MRFmatch_B-SL_dk.py     /tmp/src/MRFmatch_B-SL_dk.py
    colormaps_dk.py          /tmp/src/colormaps_dk.py
    utils                   /tmp/src/utils

%runscript
    exec python /opt/ocean/MRFmatch_mt.py "$@"

%test
    python -c "
import torch, numpy, scipy
print('OCEAN container self-test passed')
print(f'  Python  {__import__(\"sys\").version.split()[0]}')
print(f'  PyTorch {torch.__version__}')
print(f'  CUDA    {torch.version.cuda}')
print(f'  GPU(s): {torch.cuda.device_count()}')
"
